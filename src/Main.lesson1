    static void lesson1_1_low(){
        Scanner sc = new Scanner(System.in);
        double R, t, l;

        t = sc.nextDouble();
        l = sc.nextDouble();

        R = 3 * pow(t,2) + 3 * pow(l, 5) + 4.9f;
        System.out.println(R);
    }
    static void lesson1_1_mid(){
        Scanner sc = new Scanner(System.in);
        double G, y, f;

//        e = sc.nextDouble();
        y = sc.nextDouble();
        f = sc.nextDouble();

        G = (exp(2 * y) + sin(f))
                / log(3.8f * y + f);

        System.out.println(G);
    }
    static void lesson1_1_high(){
        Scanner sc = new Scanner(System.in);
        double L;
        double x, e, a, c;

        e = exp(1);
        x = sc.nextDouble();
        a = sc.nextDouble();
        c = sc.nextDouble();

        L = (sqrt( exp(x) - pow(
                        cos(pow(x, 2) * pow(a, 5)), 4
                    )
                ) + pow(
                    atan( a - pow(x, 5) ), 4
                )
            )
                / pow(abs(a + x * pow(c, 4)), e)
        ;

        System.out.println(L);
    }

    static void lesson1_1_1_low(){
        Scanner sc = new Scanner(System.in);
        double K, p, y;

        p = sc.nextDouble();
        y = sc.nextDouble();

        K = log(pow(p, 2) + pow(y, 3)) + exp(p);
        System.out.println(K);
    }


    static void lesson1_1_1_mid(){
        Scanner sc = new Scanner(System.in);
        double F, d, y;

        d = sc.nextDouble();
        y = sc.nextDouble();

        F = log(d) +
                (3.5f * pow(d, 2) + 1)
                        / pow(cos(y), 2)
        ;
        System.out.println(F);
    }
    static double cot(double x){
        return 1.0d / tan(x);
    }
    static void lesson1_1_1_high(){
        Scanner sc = new Scanner(System.in);
        double L;
        double c, x, t;

        c = sc.nextDouble();
        x = sc.nextDouble();
        t = sc.nextDouble();

        L = pow(cot(c), 2) +
                (2*pow(x, 2) + 5)
                / sqrt(c + t);
        ;
        System.out.println(L);
    }


    static void lesson1_2_low(){
        Scanner sc = new Scanner(System.in);
        long Z;
        byte type;
        System.out.print("Byte to Megabyte converter\nEnter value: ");

        Z = sc.nextLong();


        System.out.printf("MegaBytes=%.2f", ((float)Z / 1024 / 1024));
    }


    static void lesson1_2_mid(){
        Scanner sc = new Scanner(System.in);
        double x = 3.5f;
        double b = 0.4f;

        double y, c, a;

        a = log10(x);
        c = pow(a, 2) + sqrt(b * x);
        y = exp(2 * x) + pow(9.7f, c);


        System.out.printf("Y=%f", y);
    }
    static void lesson1_2_high(){
        Scanner sc = new Scanner(System.in);

        double S, t, v;

        t = sc.nextDouble();

        S = pow(t, 3) - 3 * pow(t, 2) + 2;
        v = 3 * pow(t, 2) - 6*t;


        System.out.printf("v=%f", v);
    }
    static void lesson1_3_low(){
        Scanner sc = new Scanner(System.in);

        boolean A = true;
        boolean B = false;
        boolean C = false;
        boolean a, b, c;

        // v = or
        // ^ = and
        a = (A || !A && B) || C;

        System.out.printf("A = %s\n", Boolean.toString(a));

        b = !A || A && (B || C);

        System.out.printf("B = %s\n", Boolean.toString(b));

        c = (A || B && !C) && C;

        System.out.printf("C = %s\n", Boolean.toString(C));


    }
    static void lesson3_1_mid(){}
    static void lesson1_3_high(){}

}
